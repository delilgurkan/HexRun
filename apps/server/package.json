{
  "name": "@hexrun/server",
  "version": "1.0.0",
  "private": true,
  "description": "HexRun API sunucusu (Fastify + PostgreSQL).",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r migrations dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate-cli.js",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run --coverage",
    "load": "tsx scripts/load.ts"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autocannon": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@hexrun/contracts": "1.0.0",
    "@hexrun/core": "1.0.0",
    "fastify": "^5.12.5",
    "h3-js": "^4.5.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  }
}
