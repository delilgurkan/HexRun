# ── Zorunlu (üretim) ──────────────────────────────────────────────
NODE_ENV=production
DATABASE_URL=postgres://USER:PASS@HOST:5432/hexrun
# En az 32 karakter rastgele: openssl rand -base64 48
JWT_SECRET=
# En az 16 karakter rastgele (gizli oyuncu kimliği, e-posta kodu karması)
HASH_SECRET=
# E-posta giriş kodları için SMTP (ör. smtps://user:pass@smtp.provider.com:465)
SMTP_URL=
MAIL_FROM=HexRun <no-reply@hexrun.co>
PUBLIC_BASE_URL=https://api.hexrun.co
CORS_ORIGINS=https://hexrun.co,https://www.hexrun.co

# ── Giriş sağlayıcıları ───────────────────────────────────────────
APPLE_CLIENT_IDS=co.hexrun.app
# Google OAuth istemci kimlikleri (iOS, Android, web), virgülle
GOOGLE_CLIENT_IDS=

# ── Bildirim ──────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
PUSH_ENABLED=true

# ── Entegrasyonlar (isteğe bağlı) ─────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
# Saat adaptörü imza anahtarları: garmin:xxx,coros:yyy,suunto:zzz,polar:www
WEBHOOK_SECRETS=

# ── İşletim ───────────────────────────────────────────────────────
ADMIN_EMAILS=kurucu@hexrun.co
JOBS_ENABLED=true
MIGRATE_ON_START=true
DATABASE_POOL_MAX=20
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_PER_MIN=10
RUN_RATE_LIMIT_PER_MIN=30
LOG_LEVEL=info
